{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clearview",
  "version": "0.1.2",
  "identifier": "dev.bites.clearview",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Clearview",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "label": "main",
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/clearview-collector": "../../target/release/clearview-collector",
          "/usr/lib/systemd/user/clearview-collector.service": "../../packaging/clearview-collector.system.service"
        },
        "depends": [
          "iproute2"
        ]
      }
    }
  },
  "mainBinaryName": "clearview"
}